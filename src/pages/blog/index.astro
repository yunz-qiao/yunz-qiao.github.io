---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const byNewest = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.getTime() - a.data.date.getTime();

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byNewest);

// Posts tagged `hobbies` get their own section; everything else is writing.
const isHobby = (p: (typeof posts)[number]) => p.data.tags.includes('hobbies');
const hobbies = posts.filter(isHobby);
const writing = posts.filter((p) => !isHobby(p));

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit' });

const toEntries = (list: typeof posts) =>
  list.map((p) => ({
    href: `/blog/${p.id}/`,
    title: p.data.title,
    meta: fmtDate(p.data.date),
    tags: p.data.tags,
  }));
---

<BaseLayout title="Blog">
  <h1>Blog</h1>

  <h2>Writing</h2>
  {writing.length > 0 ? (
    <PostList entries={toEntries(writing)} />
  ) : (
    <p><em>No posts yet.</em></p>
  )}

  <h2>Hobbies</h2>
  {hobbies.length > 0 ? (
    <PostList entries={toEntries(hobbies)} />
  ) : (
    <p><em>Nothing here yet.</em></p>
  )}
</BaseLayout>
