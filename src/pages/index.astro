---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';

const blog = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 5);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<BaseLayout description="Personal site of Steven Qiao.">
  <h1>Hi, I'm Steven.</h1>
  <p>
    Hi! I'm Steven, a third year undergraduate student at the University of Toronto studying Computer
    Science and Math (Honours BSc, Co-op). I am interested in Algorithms, Game Theory, and Deep
    Learning.
  </p>

  <p>
    Most recently I was a Machine Learning Runtime Engineer intern at <strong>Cerebras Systems</strong>,
    working on their waferless inference simulator. I also do research at the
    <strong>Matter Lab</strong> (autodiff and GPU support for a deep learning framework in Rust) and
    the <strong>Acceleration Consortium</strong> (neural architecture search under tight memory
    budgets). More detail on the <a href="/experience/">Experience</a> page.
  </p>

  <p>
    I'm Co-President and coach of the <strong>UofT ICPC Club</strong>. We placed 12th of 52 teams at
    the 2026 ICPC North America Championship and qualified for the 2026 World Finals.
  </p>

  <p>
    In my free time, I enjoy spending time doing Competitive Programming, playing Table Tennis and
    watching Formula 1. I write about that sort of thing on the <a href="/blog/">blog</a>.
  </p>

  <hr />

  <h2>Recent Blogs</h2>
  {blog.length > 0 ? (
    <PostList
      entries={blog.map((p) => ({
        href: `/blog/${p.id}/`,
        title: p.data.title,
        meta: fmtDate(p.data.date),
        tags: p.data.tags,
      }))}
    />
  ) : (
    <p><em>No posts yet.</em></p>
  )}

  <hr />

  <h2>Projects that I've worked on</h2>
  {projects.length > 0 ? (
    <PostList
      entries={projects.map((p) => ({
        href: `/projects/${p.id}/`,
        title: p.data.title,
        meta: String(p.data.year),
        tags: p.data.tags,
      }))}
    />
  ) : (
    <p><em>No projects yet.</em></p>
  )}
</BaseLayout>
