---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Experience">
  <h1>Experience</h1>

  <p>
    Replace this page with your résumé / CV content. Below is a stub structure you can edit
    directly in <code>src/pages/experience.astro</code> — or convert this into a markdown-rendered
    page later if you prefer authoring in markdown.
  </p>

  <h2>Work</h2>
  <ul>
    <li><strong>Role</strong> &middot; Company &middot; <span style="color:var(--fg-muted)">2025&ndash;present</span>
      <ul><li>One-line description of what you did.</li></ul>
    </li>
  </ul>

  <h2>Education</h2>
  <ul>
    <li><strong>Degree</strong> &middot; Institution &middot; <span style="color:var(--fg-muted)">YYYY&ndash;YYYY</span></li>
  </ul>

  <h2>Other</h2>
  <ul>
    <li>Awards, teaching, talks, etc.</li>
  </ul>
</BaseLayout>
