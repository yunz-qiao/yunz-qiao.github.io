---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="School">
  <h1>School</h1>

  <p>
    Coursework, notes, and academic work. Replace this stub with real content &mdash; or convert
    this page into a markdown-rendered layout later if you'd rather author it in markdown.
  </p>

  <h2>Current</h2>
  <ul>
    <li><strong>Institution</strong> &middot; Program &middot; <span style="color:var(--fg-muted)">YYYY&ndash;present</span></li>
  </ul>

  <h2>Coursework</h2>
  <table>
    <thead>
      <tr><th>Term</th><th>Course</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr><td>YYYY-FA</td><td>Course name</td><td>&mdash;</td></tr>
    </tbody>
  </table>

  <h2>Notes & write-ups</h2>
  <p><em>Drop links here, or move long-form notes into the blog and link to the relevant tag.</em></p>
</BaseLayout>
